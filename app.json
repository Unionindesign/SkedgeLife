{
  "expo": {
    "name": "SkedgeLife",
    "slug": "skedgelife",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skedgelife.app"
    },
    "android": {
      "package": "com.skedgelife.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
