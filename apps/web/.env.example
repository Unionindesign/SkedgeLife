# Copy to apps/web/.env.local (not committed). Next.js inlines NEXT_PUBLIC_* values.
#
# Local Supabase (npm run db:start). These are the fixed local development
# values; they only work against your own machine. Hosted values go in Vercel
# only, never in a file here. Use the publishable key, never the secret key.
