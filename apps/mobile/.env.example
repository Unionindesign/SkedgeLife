# Copy to apps/mobile/.env (not committed). Expo inlines EXPO_PUBLIC_* values at build time.
#
# Local Supabase (npm run db:start). These are the fixed local development
# values; they only work against your own machine. Your phone can't reach
# 127.0.0.1, so for Expo Go use the hosted project's URL and publishable key
# from its dashboard (Project Settings -> API Keys).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
